# Used by docker-compose.yml / docker-compose.prod.yml (Compose reads a
# ".env" file in this directory automatically). Copy to ".env" and fill in
# real values before running the prod stack — POSTGRES_PASSWORD has no
# insecure default in prod and compose will refuse to start without it.

POSTGRES_USER=devprince
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=devprince_portfolio

# Your real public URL once a domain is chosen, e.g. https://devprince.dev
# Used for the server's CORS allow-list (CLIENT_ORIGIN).
PUBLIC_ORIGIN=http://localhost
