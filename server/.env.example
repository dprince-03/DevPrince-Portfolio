NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Set to "true" only when served over HTTPS (real deployment) - a Secure cookie
# is silently dropped by browsers over plain HTTP, which would break login.
COOKIE_SECURE=false

# Docker-Compose Postgres defaults; override if you run Postgres elsewhere.
# Host port is 5434 (not 5432) to avoid clashing with other local Postgres instances.
DATABASE_URL=postgresql://devprince:devprince@localhost:5434/devprince_portfolio?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Only used by `npm run seed` to create the single admin account
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Optional — powers the real contribution-graph/streak widget (GET /api/github/contributions).
# Without it, that endpoint responds 503 and the widget just doesn't render; everything else
# (repo stats, top repos, activity feed) uses GitHub's public REST API and needs no token.
# Classic personal access token, no scopes required (github.com/settings/tokens) — it only
# needs to be *authenticated* to read public contribution data over GraphQL. Never exposed to
# the browser; the server calls GitHub with it and returns just the computed result.
GITHUB_TOKEN=
